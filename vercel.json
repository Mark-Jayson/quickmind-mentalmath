{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "build": {
        "env": {
            "SUPABASE_URL": "@supabase-url",
            "SUPABASE_KEY": "@supabase-key"
        }
    }
}